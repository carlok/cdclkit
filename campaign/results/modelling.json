  "findings": [
    {
      "id": "modelling-1",
      "severity": "Critical",
      "summary": "pyeq compiles `x and y` / `x or y` in a value position to 0/1, not to the operand Python returns: wrong proved=True, and proved=False with overflow_only=True"
    },
    {
      "id": "modelling-2",
      "severity": "Critical",
      "summary": "pyeq drops every bare expression statement that is not a call: walrus, yield and raising expressions vanish, giving wrong proved=True"
    },
    {
      "id": "modelling-3",
      "severity": "Critical",
      "summary": "pyeq ignores decorators: a function wrapped with functools.wraps is compiled undecorated"
    },
    {
      "id": "modelling-4",
      "severity": "Critical",
      "summary": "pyeq accepts range() and range(stop=3) as empty loops, and a shadowed range as the builtin, proving equal functions that raise TypeError on every input"
    },
    {
      "id": "modelling-5",
      "severity": "Critical",
      "summary": "Model.solve reuses its solver when a new constraint adds no variable: the model returned violates the constraint, and a contradiction reads as SAT"
    },
    {
      "id": "modelling-6",
      "severity": "Bug",
      "summary": "Model.solve after Model.solutions keeps the blocking clauses: None on a satisfiable model"
    },
    {
      "id": "modelling-7",
      "severity": "Bug",
      "summary": "A Python bool in an expression becomes literal 0 or 1 of variable 0: m.add(True), b | False and a == b on BoolVars all constrain the first variable"
    },
    {
      "id": "modelling-8",
      "severity": "Bug",
      "summary": "at_most_k and exactly_k with k < 0 are satisfiable; the sum cannot be negative"
    },
    {
      "id": "modelling-9",
      "severity": "Bug",
      "summary": "IntVar.ge and le assume a sorted domain: wrong solutions on int_var([2, 1])"
    },
    {
      "id": "modelling-10",
      "severity": "Bug",
      "summary": "A repeated domain value gets two literals and is_ knows one: x != 1 still allows 1"
    },
    {
      "id": "modelling-11",
      "severity": "Bug",
      "summary": "at_most_one([]) and exactly_one([]) with method='totalizer' die with RecursionError"
    },
    {
      "id": "modelling-12",
      "severity": "Bug",
      "summary": "pyeq reports a width the circuit does not have: an unused key in widths claims 'equivalent at 8 bits' for a 4-bit circuit, and no parameters claims 0 bits for 8"
    },
    {
      "id": "modelling-13",
      "severity": "Bug",
      "summary": "pyeq ignores positional-only parameters, then crashes with TypeError building python_outputs for a counterexample"
    },
    {
      "id": "modelling-14",
      "severity": "Note",
      "summary": "proof_steps differs between the engines, as tests/test_pyeq.py documents; a field disagreement that is not a bug"
    },
    {
      "id": "modelling-15",
      "severity": "Note",
      "summary": "Model.solutions() without project repeats user-level solutions, one per state of the auxiliary variables, under a docstring that says distinct"
    },
    {
      "id": "modelling-16",
      "severity": "Note",
      "summary": "differential_solve compares a CNF with itself when a model uses only all_different, sum_leq, sum_geq or parity"
    },
    {
      "id": "modelling-17",
      "severity": "Note",
      "summary": "pyeq accepts widths of 0 and below and proves anything at them, and treats an unknown engine name as Python"
    }
  ],
  "not_checked": [
    "Model(config=...): every model runs under the default Config",
    "Model has no engine parameter, so native is judged on the Model's CNF, not through Model.solve",
    "Encoder gates called with an explicit out=, and Encoder features the Model API does not expose (campaign/gen_encodings.py owns them)",
    "Optimiser.run(target=...), max_iterations and resuming; only optimise() is run",
    "a weighted optimum has no API, so it is judged by bounding sum_leq at the optimum and one below",
    "CNF checks by DPLL look at up to 32 user assignments per model, not all of them",
    "unprojected solutions() is capped at 2000 models per instance",
    "EncodingDisagreement raised by a genuinely wrong encoding: none occurred, and no stub injects one",
    "pyeq above 9 input bits or 7 bits of width: the oracle enumerates every input",
    "pyeq's python_error field: no generated function raises in Python",
    "ProofRejected: no proof was rejected, and no stub injects a bad proof into pyeq",
